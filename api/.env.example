NODE_ENV=development
PORT=3000

# PayPal sandbox — developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# OpenAI. Pin the model id verified in Task 7.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

FIREBASE_PROJECT_ID=

# Shared secret for Render Workflow -> /v1/internal/* calls
INTERNAL_TOKEN=

# Optional: hours an unpaid checkout link stays open before the expiry sweep
# closes it, counted from when it was sent. Empty or unset is 168 (7 days).
ORDER_EXPIRY_HOURS=

# Origin PayPal sends the buyer back to. Empty uses the hosted Render service.
PUBLIC_BASE_URL=https://sorted-api-a4zo.onrender.com
# Optional: sandbox (default) or live. Live needs a Live app's client id, secret and webhook id.
PAYPAL_ENV=sandbox
